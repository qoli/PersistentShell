FROM alpine:3.22

RUN apk add --no-cache openssh \
    && mkdir -p /run/sshd \
    && printf '%s\n' \
       'PasswordAuthentication yes' \
       'PermitRootLogin yes' \
       'PubkeyAuthentication yes' \
       'UsePAM no' \
       >> /etc/ssh/sshd_config \
    && echo 'root:persistent-shell-acceptance' | chpasswd \
    && ssh-keygen -A

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
